    "@node-rs/argon2": "2.2.2",
    "@nona/contracts": "workspace:*",
    "@nona/payments": "workspace:*",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.7",
    "@nona/config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
