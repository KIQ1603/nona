# Copy to .env — never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://nona:nona@localhost:5433/nona
REDIS_URL=redis://localhost:6390
API_PORT=4100
API_PUBLIC_URL=http://localhost:4100
WEB_ORIGIN=http://localhost:3100
# Used by the Next.js server to call the API
NEXT_PUBLIC_API_URL=http://localhost:4100
MEDIA_BASE_URL=http://localhost:3100/media

# Object storage (MinIO locally; any S3-compatible service in production)
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nona-media
S3_ACCESS_KEY=nona
S3_SECRET_KEY=nona-secret

# Development-only admin account created by `pnpm db:seed`. NEVER use these values in production.
SEED_ADMIN_EMAIL=admin@nona.local
SEED_ADMIN_PASSWORD=ChangeMe!2026

# Outgoing email (Mailpit locally: UI at http://localhost:8025)
# --- Phone OTP (Zalo ZNS) ---
# simulator: nothing is sent, the code is shown in the account page and written to the worker log (dev only).
# zalo: the worker sends a ZNS template message. Required in production.
SMS_MODE=simulator
# Keys the hash of one-time codes (>= 24 chars, required in production).
OTP_SECRET=
# Worker, when SMS_MODE=zalo (see docs/runbooks/zalo-otp-setup.md):
ZALO_ZNS_TEMPLATE_ID=
# Name of the OTP variable in the template (and optionally the validity-in-minutes variable).
ZALO_ZNS_CODE_PARAM=otp
ZALO_ZNS_TTL_PARAM=
# Leave empty in production. 'development' = test messages before the template is approved.
ZALO_ZNS_MODE=
# Recommended: Zalo OAuth, the worker keeps the access token fresh by itself.
ZALO_APP_ID=
ZALO_APP_SECRET=
# Refresh token from the first authorisation (used once to seed the database).
ZALO_OA_REFRESH_TOKEN=
# 32 bytes, base64 (openssl rand -base64 32): encrypts the stored tokens.
ZALO_TOKEN_KEY=
# Alternative without OAuth (token expires, only for a quick test):
ZALO_ZNS_ACCESS_TOKEN=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=NONA <no-reply@nona.local>

# Payments. "simulator" runs a local fake VNPay (development ONLY; refused when NODE_ENV=production).
PAYMENTS_MODE=simulator
# Real VNPay (required when PAYMENTS_MODE=vnpay):
# VNPAY_TMN_CODE=
# VNPAY_HASH_SECRET=
# VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Service-to-service token (worker -> API jobs, metrics). Generate: openssl rand -base64 32
INTERNAL_API_TOKEN=dev-internal-token-change-me-0123456789
INTERNAL_API_URL=http://localhost:4100

# Staff two-factor. Set REQUIRE_STAFF_MFA=true and a 32-byte base64 MFA_ENCRYPTION_KEY in production
# (openssl rand -base64 32).
REQUIRE_STAFF_MFA=false
# MFA_ENCRYPTION_KEY=
